{
	"name": "vidup",
	"version": "1.0.21",
	"description": "Synchronize a local directory of video files to remote streaming services.",
	"keywords": [
		"bunnycdn-stream",
		"bunnycdn",
		"cli",
		"homebrew-formula",
		"npm-package",
		"sync",
		"upload",
		"video"
	],
	"homepage": "https://github.com/kitschpatrol/vidup",
	"bugs": "https://github.com/kitschpatrol/vidup/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/vidup.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"vidup": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/yargs": "^17.0.35",
		"bunnycdn-stream": "^2.5.5",
		"execa": "^10.2.1",
		"ffmpeg-static": "^5.3.0",
		"hasha": "^7.0.0",
		"lognow": "^0.8.7",
		"lowdb": "^7.0.1",
		"ora": "^10.0.0",
		"pretty-ms": "^10.0.0",
		"untildify": "^6.0.0",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "0.4.0",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~24.13.6",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.1",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
